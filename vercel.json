{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/img/opt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/scheduled",
      "destination": "/insights/",
      "permanent": false
    },
    {
      "source": "/scheduled/(.*)",
      "destination": "/insights/",
      "permanent": false
    },
    {
      "source": "/digital-marketing",
      "destination": "/growth-marketing-consultant/",
      "permanent": true
    },
    {
      "source": "/digital-marketing/",
      "destination": "/growth-marketing-consultant/",
      "permanent": true
    },
    {
      "source": "/mobile-app-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile-app-development/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website-development-hosting",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website-development-hosting/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/savatree",
      "destination": "/",
      "permanent": true
    },
